# npm run env:init creates private .env with mode 0600; see docs/setup.md.
# Shared settings. SSH keys stay in your existing ssh configuration, not here.
CAMERA_USERNAME=
CAMERA_PASSWORD=
PROXY_USERNAME=
PROXY_PASSWORD=
# Required dashboard login password (12-256 characters); env:init generates it.
DASHBOARD_PASSWORD=
# Documentation-only addresses: replace with your camera IPv4 addresses.
CAMERA_1_HOST=192.0.2.10
CAMERA_2_HOST=192.0.2.11
CAMERA_3_HOST=192.0.2.12
CAMERA_4_HOST=192.0.2.13
OFFICE_RTSP_PORT=554
BRIDGE_SSH_HOST=camera-gateway
ADVERTISE_HOST=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
STREAM_BIND_ADDRESS=127.0.0.1
VIDEO_PROFILE=480p
VIDEO_FPS=10
# Native phone dashboard addresses (example values). After changing, run: npm run phone:web-access
PHONE_LAN_IP=192.168.1.20
PHONE_TAILSCALE_IP=100.64.0.10

# DIRECT LAN: enable this entire block and comment out the BRIDGE block.
CONNECTION_MODE=office
CAMERA_1_RTSP_HOST=192.0.2.10
CAMERA_1_RTSP_PORT=554
CAMERA_2_RTSP_HOST=192.0.2.11
CAMERA_2_RTSP_PORT=554
CAMERA_3_RTSP_HOST=192.0.2.12
CAMERA_3_RTSP_PORT=554
CAMERA_4_RTSP_HOST=192.0.2.13
CAMERA_4_RTSP_PORT=554

# BRIDGE: enable this entire block and comment out the DIRECT LAN block.
# Run npm run bridge on the Docker host and leave it running, then restart Compose.
# host.docker.internal works with Docker Desktop/OrbStack; see docs/setup.md for Linux.
# CONNECTION_MODE=bridge
# CAMERA_1_RTSP_HOST=host.docker.internal
# CAMERA_1_RTSP_PORT=15554
# CAMERA_2_RTSP_HOST=host.docker.internal
# CAMERA_2_RTSP_PORT=15555
# CAMERA_3_RTSP_HOST=host.docker.internal
# CAMERA_3_RTSP_PORT=15556
# CAMERA_4_RTSP_HOST=host.docker.internal
# CAMERA_4_RTSP_PORT=15557